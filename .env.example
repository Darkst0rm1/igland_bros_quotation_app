# Igland Bros Quotation Application — local development configuration.
#
# Copy to `.env` and adjust. NEVER commit `.env`.
#
# On Streamlit Community Cloud these same keys are set in the app's Secrets
# panel (TOML) instead; modules/config.py reads st.secrets first and falls back
# to the environment, so one code path serves both.

# --- Environment ----------------------------------------------------------
APP_ENV=development                       # development | production
LOG_LEVEL=INFO
TZ=Europe/Istanbul

# --- Database -------------------------------------------------------------
# Local development (no cloud account needed):
DATABASE_URL=sqlite:///./igland.db
# Production (managed PostgreSQL, e.g. Supabase / Neon):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Session & authentication --------------------------------------------
# SECRET_KEY is required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
SESSION_TIMEOUT_MINUTES=60
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- File storage ---------------------------------------------------------
# Community Cloud has an ephemeral filesystem: use `s3` in production so that
# uploaded price lists and generated PDFs survive a redeploy.
STORAGE_BACKEND=local                     # local | s3
LOCAL_STORAGE_ROOT=./uploads
GENERATED_QUOTES_DIR=./generated_quotes

# S3-compatible settings (required only when STORAGE_BACKEND=s3).
# Supabase Storage, Cloudflare R2 and AWS S3 all speak this API.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.xlsx,.xls,.png,.jpg,.jpeg,.pdf
