# Soneet Quotation Application — every setting the application reads.
#
# Copy to `.env` and adjust. NEVER commit `.env`.
#
# This file is the complete list. If `modules/config.py` grows a field, it
# belongs here too — an undocumented setting is one nobody sets deliberately.
#
# Three deployments read these, and each takes them from a different place:
#
#   employee app   Streamlit Community Cloud   Secrets panel (TOML)
#   customer portal / worker   Render          env group `soneet-shared`
#   local development          this file       copied to `.env`
#
# modules/config.py reads st.secrets first and falls back to the environment,
# so one code path serves all three.
#
# SHAPES GO IN COMMENTS, NOT IN VALUES. A blank required setting fails at
# startup with the name of what is missing. A plausible-looking placeholder
# starts cleanly and fails later, somewhere unrelated: STORAGE_ENDPOINT_URL sat
# at a literal `https://<account-id>...` in production for hours, logging a
# healthy "Using object storage (bucket=…)" at boot while every document job
# failed, because boto3 only rejects a malformed endpoint when the client is
# constructed. Leave it empty and let it complain.

# --- Environment ----------------------------------------------------------
APP_ENV=development                       # development | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
TZ=Europe/Istanbul                        # production runs America/Toronto

# --- Database -------------------------------------------------------------
# Local development (no cloud account needed):
DATABASE_URL=sqlite:///./soneet.db
# Production (managed PostgreSQL, e.g. Neon / Supabase):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# A bare postgresql:// or postgres:// URL is rewritten to postgresql+psycopg://
# automatically — psycopg2 is not installed, and the providers all hand out the
# prefix for the driver this project does not use.
#
# Prefer the DIRECT endpoint over a pooled one when running migrations: pooled
# connections are a poor fit for DDL.

# --- Session & authentication --------------------------------------------
# SECRET_KEY is required in production. It signs portal submission nonces and
# derives the opaque line references customers submit, so changing it
# invalidates every issued link. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
SESSION_TIMEOUT_MINUTES=60                # 5–1440
BCRYPT_ROUNDS=12                          # 10–16
MAX_FAILED_LOGINS=5                       # 1–20
LOCKOUT_MINUTES=15                        # 1–1440

# --- File storage ---------------------------------------------------------
# Community Cloud has an ephemeral filesystem: use `s3` in production so that
# uploaded price lists and generated PDFs survive a redeploy.
STORAGE_BACKEND=local                     # local | s3
LOCAL_STORAGE_ROOT=./uploads
GENERATED_QUOTES_DIR=./generated_quotes

# S3-compatible settings (required only when STORAGE_BACKEND=s3).
# Cloudflare R2, Supabase Storage and AWS S3 all speak this API.
#
# The bucket stays PRIVATE. The application never derives a public object URL:
# price lists, logos and quotation PDFs are served through routes that check a
# permission or validate a capability token first.
#
# R2 endpoint shape: https://ACCOUNT_ID.r2.cloudflarestorage.com
# ACCOUNT_ID is the 32-hex-character string in any R2 dashboard URL.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto                       # R2 ignores this; S3 wants a real region
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_MB=10                          # 1–100
ALLOWED_UPLOAD_EXTENSIONS=.xlsx,.xls,.png,.jpg,.jpeg,.pdf

# --- Customer portal (the separate public service) ------------------------
# The origin customers' links point at, e.g. https://quotes.iglandbros.com.
# Must be https in production, and must match the portal's public address
# exactly — the approval origin check compares against it. It cannot be filled
# in before the service exists: deploy once, set it, redeploy.
PORTAL_BASE_URL=
# Shown on the "link not available" page so a customer holding an expired link
# knows who to contact. Optional.
PORTAL_SUPPORT_EMAIL=
# How long a link stays live when the quotation carries no validity date.
PORTAL_LINK_DAYS=30                       # 1–365

# --- Portal branding ------------------------------------------------------
# Identity — legal name, address, phone, email, logo — always comes from
# CompanySettings in the database. These override only how the brand is
# *presented*, so the portal is not wired to one company. Blank means "use the
# company identity", which is the default and almost always the right answer.
PORTAL_BRAND_NAME=
PORTAL_BRAND_SLOGAN=
PORTAL_BRAND_LEGAL_FOOTER=
PORTAL_BRAND_PRIMARY=                     # CSS colour, e.g. #1f4e79
PORTAL_BRAND_SECONDARY=
PORTAL_BRAND_ACCENT=

# Fixed-window rate limits, per client address. Generous on purpose: a customer
# refreshing, or forwarding the link to a colleague, must never be affected.
PORTAL_VIEW_RATE_PER_MINUTE=60            # 1–1000
PORTAL_SUBMIT_RATE_PER_HOUR=10            # 1–200

# --- Email delivery -------------------------------------------------------
# Off by default, in every environment. With this false, messages are still
# queued — the outbox row is the business record — and delivered whenever it is
# switched on. That is deliberately not the same as dropping them. Turn this on
# LAST, after company details and SMTP are set and preflight is clean.
EMAIL_ENABLED=false
# memory: captures, sends nothing (tests). console: logs a redacted summary and
# cannot open a socket (development). smtp: the only one that reaches anything.
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Where a customer's reply goes, when it should not go to the From address.
EMAIL_REPLY_TO=
# Comma-separated. Blank means internal notifications are not queued at all.
EMAIL_INTERNAL_RECIPIENTS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587) or tls (465). There is deliberately no unencrypted mode: the
# session carries both the credentials and the customer's quotation link.
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=20                   # 1–120
EMAIL_MAX_ATTEMPTS=6                      # 1–20, then the message shows as failed

# Versioned keys that seal the capability URL a queued invitation carries. The
# portal stores only token hashes, and this is what keeps that true while a
# message waits in the outbox.
#
#   IDENTICAL ON EVERY HOST. The app seals; the worker opens. Different key
#   material means nothing is ever delivered, and both processes now refuse to
#   start rather than fail silently. See docs/GO_LIVE.md section 3.
#
# Format: v1:base64key,v2:base64key — rotation means ADDING a version and
# pointing EMAIL_PAYLOAD_KEY_VERSION at it. Keep the old key: rows queued under
# it can still be opened.
#
# Generate: python -c "from modules.secret_box import generate_key; print(generate_key())"
EMAIL_PAYLOAD_KEYS=
EMAIL_PAYLOAD_KEY_VERSION=v1
# How long a queued invitation stays resendable before its link is erased, so a
# link cannot be resurrected from an old queue row indefinitely.
EMAIL_PAYLOAD_TTL_HOURS=72                # 1–720

# --- Background worker ----------------------------------------------------
# Sweeps storage cleanups, accepted-PDF jobs and the email outbox. Run it with
# `python -m modules.worker --loop`, or `--once` from a scheduler. It cannot
# run on Streamlit Community Cloud, which sleeps when idle.
WORKER_POLL_SECONDS=30                    # 5–3600
WORKER_BATCH_SIZE=20                      # 1–500, per subsystem per sweep
WORKER_LEASE_SECONDS=300                  # 30–3600, before another worker may claim a row
# A health signal older than this is reported to employees as stale. Wider than
# the poll interval on purpose: a worker that missed one sweep has not stopped,
# and an indicator that cries wolf gets ignored.
WORKER_STALE_AFTER_SECONDS=900            # 60–86400

# Optional file-based liveness: touched after every sweep, containing counts and
# a timestamp and nothing identifying. Only useful where something watches the
# filesystem. On Render the DB-backed heartbeat is what the employee app reads,
# and this can stay empty.
WORKER_HEALTH_FILE=
